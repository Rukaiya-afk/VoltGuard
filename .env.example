# VoltGuard Environment Configuration

# Optional: External Python FastAPI Backend URL
# BACKEND_URL=http://localhost:8000

# 1. Supabase PostgreSQL Cloud Database
# Set these to enable persistent cloud PostgreSQL storage for tickets, sensor metrics, and bills.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Twilio Real-Time SMS & OTP Dispatch
# Set these to enable live SMS text alerts and security OTP delivery to Pune residents.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
